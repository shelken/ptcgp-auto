# PTCGP Auto Configuration
# Copy this file to .env and modify as needed
# Priority: CLI args > Environment variables > .env file > defaults

# ADB connection address (host:port or just port)
# ADDRESS=127.0.0.1:5555

# Interface language (zh_Hant or en_US)
# LANGUAGE=zh_Hant

# Enable debug mode (save screenshots and logs)
# DEBUG=false

# Disable auto-battle feature in battle
# NO_AUTO_BATTLE=false

# WeCom webhook key for notifications (enables notification when set)
# NOTIFY_KEY=your-webhook-key-here

# Disable notification sound
# NO_NOTIFY_SOUND=false

# Tutorial mode (skip main loop)
# TUTORIAL=false
