{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    "helpers:pinGitHubActionDigests",
    //"github>shelken/home-ops//.renovate/labels.json5",
    "github>shelken/home-ops//.renovate/semanticCommits.json5",
    "github>shelken/home-ops//.renovate/automerge.json5",
    "local>.renovate/disable.json5",
    ":dependencyDashboard",
    ":disableRateLimiting",
    ":semanticCommits",
    ":timezone(Asia/Shanghai)",
  ],
  mode: "auto",
  dependencyDashboard: true,
  dependencyDashboardTitle: "Renovate Dashboard 🤖",
}
